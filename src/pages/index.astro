---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCine from '../components/HeroCine.astro';
import MetricBand from '../components/MetricBand.astro';
import PublicationCard from '../components/PublicationCard.astro';
import NewsList from '../components/NewsList.astro';
import CineLoop from '../components/CineLoop.astro';
import ContourMark from '../components/ContourMark.astro';
import { getFeaturedPublications, getNews, getResearchThemes } from '../lib/collections';
import { cine } from '../lib/contours';
import { site } from '../data/site';
import { copy } from '../data/copy';

const featured = await getFeaturedPublications(3);
const themes = await getResearchThemes();
const news = await getNews(5);

const externals = [
  { label: 'GitHub', href: site.links.github },
  { label: 'Google Scholar', href: site.links.scholar },
  { label: 'ORCID', href: site.links.orcid },
  { label: 'LinkedIn', href: site.links.linkedin },
].filter((l) => l.href);

/**
 * A capability chip anchors to its theme card on this page — but only if that
 * card exists. Otherwise it goes to /research, so the chips can never point at
 * an id that was never rendered.
 */
const themeIds = new Set(themes.map((t) => t.data.id));
const chips = site.capabilities.map((c) => ({
  label: c.label,
  href: themeIds.has(c.id) ? `#${c.id}` : '/research',
}));

// Each theme card holds a different moment in the cycle, so the row reads as
// one heart sampled across a beat rather than four copies of the same frame.
const frameFor = (i: number) => Math.round((i * cine.frames) / Math.max(themes.length, 1));
---

<BaseLayout bleed>
  {/* ── Hero ──────────────────────────────────────────────────────────── */}
  <section class="hero glow">
    <ContourMark class="watermark" frame={cine.esIdx} weight={4} />

    <div class="wrap grid">
      <div class="intro">
        <p class="eyebrow" data-reveal="0">
          {[site.role, site.affiliation].filter(Boolean).join(' · ')}
        </p>

        <h1 data-reveal="1">{site.name}</h1>
        <p class="tagline" data-reveal="2">{site.tagline}</p>
        <p class="statement" data-reveal="3">{site.statement}</p>

        <ul class="chips" data-reveal="4">
          {chips.map((c) => <li><a class="chip" href={c.href}>{c.label}</a></li>)}
        </ul>

        <div class="cluster" data-reveal="5">
          <a class="btn btn-primary" href="/publications">Publications</a>
          <a class="btn" href={`mailto:${site.email}`}>Get in touch</a>
        </div>
      </div>

      <div class="media" data-reveal="2">
        <HeroCine />
      </div>
    </div>
  </section>

  <MetricBand />

  {/* ── Research: the signature row. Four loops on one clock. ─────────── */}
  <section class="section wrap" aria-labelledby="h-research">
    <div class="section-head">
      <p class="eyebrow">{copy.home.research.eyebrow}</p>
      <h2 id="h-research">{copy.home.research.title}</h2>
      <p class="lede">{copy.home.research.lede}</p>
    </div>

    {
      themes.length === 0 ? (
        <p class="empty">{copy.home.research.empty}</p>
      ) : (
        <>
          <ul class="theme-grid">
            {themes.map((theme, i) => (
              /* id is the hero chips' anchor target — see `chips` above. */
              <li id={theme.data.id} class="card theme" data-reveal={Math.min(i, 3)}>
                <div class="card-media">
                  <CineLoop
                    alt={`${theme.data.title} — cardiac cine loop`}
                    frame={frameFor(i)}
                  />
                  <span class="num badge">{String(i + 1).padStart(2, '0')}</span>
                </div>
                <div class="card-body">
                  <h3>
                    <a class="card-link" href={`/research#${theme.data.id}`}>
                      {theme.data.title}
                    </a>
                  </h3>
                  <p class="theme-summary">{theme.data.summary}</p>
                </div>
              </li>
            ))}
          </ul>
          <a class="more" href="/research">{copy.home.research.more} →</a>
        </>
      )
    }
  </section>

  {/* ── Selected work ─────────────────────────────────────────────────── */}
  <section class="band" aria-labelledby="h-selected">
    <div class="section wrap">
      <div class="section-head">
        <p class="eyebrow">{copy.home.selected.eyebrow}</p>
        <h2 id="h-selected">{copy.home.selected.title}</h2>
        <p class="lede">{copy.home.selected.lede}</p>
      </div>

      {
        featured.length === 0 ? (
          <p class="empty">{copy.home.selected.empty}</p>
        ) : (
          <>
            <ul class="pub-grid">
              {featured.map((pub, i) => (
                <li data-reveal={Math.min(i, 3)}>
                  <PublicationCard pub={pub} variant="card" />
                </li>
              ))}
            </ul>
            <a class="more" href="/publications">{copy.home.selected.more} →</a>
          </>
        )
      }
    </div>
  </section>

  {/* ── News + contact, side by side. Neither fills a row alone. ──────── */}
  <section class="section wrap split">
    <div aria-labelledby="h-news">
      <div class="section-head">
        <p class="eyebrow" id="h-news">{copy.home.news.eyebrow}</p>
      </div>
      {news.length === 0 ? <p class="empty">{copy.home.news.empty}</p> : <NewsList items={news} />}
    </div>

    <aside class="contact card glow" aria-labelledby="h-contact">
      <ContourMark class="contact-mark" frame={cine.edIdx} weight={5} />
      <div class="contact-body">
        <p class="eyebrow">{copy.home.contact.eyebrow}</p>
        <h2 id="h-contact">{copy.home.contact.title}</h2>
        <p class="contact-lede">{copy.home.contact.lede}</p>
        <a class="btn btn-primary" href={`mailto:${site.email}`}>{site.email}</a>
        {
          externals.length > 0 && (
            <ul class="chips">
              {externals.map((l) => (
                <li>
                  <a class="chip" href={l.href} rel="me noopener">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </aside>
  </section>
</BaseLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────── */

  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 6vh, 5rem) var(--section-y);
    overflow: hidden;
  }

  /* The segmentation outline, blown up and bled off the left edge. It is the
     same polygon the hero canvas draws — the ornament is the data.

     `:global` is required: a child component's root element carries only its
     own scope id, so a bare `.watermark` here would never match the <svg>. */
  .hero :global(.watermark) {
    position: absolute;
    z-index: -1;
    top: 50%;
    left: clamp(-22rem, -16vw, -10rem);
    width: min(30rem, 46vw);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .intro > * + * {
    margin-block-start: var(--sp-5);
  }

  h1 {
    font-size: var(--text-4xl);
    margin-block-start: var(--sp-4);
  }

  .tagline {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--ink-secondary);
    letter-spacing: var(--tracking-tight);
    margin-block-start: var(--sp-2);
  }

  .statement {
    max-width: 52ch;
    color: var(--ink-secondary);
  }

  /* ── Research grid ──────────────────────────────────────────────────── */

  .theme-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--sp-5);
  }

  .theme {
    scroll-margin-top: 6rem;
  }

  /* Square cine cropped to a letterbox, so four cards in a row stay compact
     without stretching the frame. */
  .theme .card-media {
    aspect-ratio: 5 / 4;
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .theme .card-media > :global(.cine) {
    width: 100%;
  }

  .badge {
    position: absolute;
    z-index: 3;
    top: var(--sp-3);
    left: var(--sp-3);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(4px);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-wide);
    color: #fff;
  }

  .theme h3 {
    font-size: var(--text-lg);
  }

  .theme h3 a {
    text-decoration: none;
  }

  .theme:hover h3 a {
    color: var(--accent);
  }

  .theme-summary {
    font-size: var(--text-base);
    color: var(--ink-secondary);
  }

  /* ── Selected work ──────────────────────────────────────────────────── */

  .pub-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--sp-5);
  }

  /* Caps the tile when there are fewer papers than columns — auto-fit would
     otherwise stretch two cards across the whole row. */
  .pub-grid > li {
    display: flex;
    max-width: 30rem;
  }

  .pub-grid > li > :global(*) {
    flex: 1;
  }

  /* ── News + contact ─────────────────────────────────────────────────── */

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .contact {
    position: relative;
    overflow: hidden;
  }

  .contact:hover {
    transform: none;
  }

  /* Sized by height against the card, not by width: the cropped mark is
     portrait, and a width-based size makes it so tall that only a stray
     diagonal sliver survives the corner crop. */
  .contact :global(.contact-mark) {
    position: absolute;
    z-index: 0;
    right: -2.5rem;
    bottom: -3rem;
    width: auto;
    height: 125%;
    opacity: 0.7;
    pointer-events: none;
  }

  .contact-body {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--sp-4);
    justify-items: start;
    padding: var(--sp-6);
  }

  .contact-lede {
    color: var(--ink-secondary);
    font-size: var(--text-base);
  }

  @media (width < 60rem) {
    .grid {
      grid-template-columns: 1fr;
    }
    .media {
      max-width: 34rem;
    }
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
