---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCine from '../components/HeroCine.astro';
import MetricBand from '../components/MetricBand.astro';
import PublicationCard from '../components/PublicationCard.astro';
import NewsList from '../components/NewsList.astro';
import CineLoop from '../components/CineLoop.astro';
import CatMark from '../components/CatMark.astro';
import ContactForm from '../components/ContactForm.astro';
import Avatar from '../components/Avatar.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import { getFeaturedPublications, getNews, getResearchThemes } from '../lib/collections';
import { getProfiles } from '../lib/profiles';
import { cine } from '../lib/contours';
import { site } from '../data/site';
import { copy } from '../data/copy';

const featured = await getFeaturedPublications(3);
const themes = await getResearchThemes();
const news = await getNews(5);

// The contact card is a short call to action, not a directory: dblp and ORCID
// are indexes, not places anyone clicks from here. Both stay in the rail, the
// footer, the CV and the structured data.
const externals = getProfiles(['dblp', 'orcid']);

/**
 * A capability chip anchors to its theme card on this page — but only if that
 * card exists. Otherwise it goes to /research, so the chips can never point at
 * an id that was never rendered.
 */
const themeIds = new Set(themes.map((t) => t.data.id));
const chips = site.capabilities.map((c) => ({
  label: c.label,
  href: themeIds.has(c.id) ? `#${c.id}` : '/research',
}));

// Each theme card holds a different moment in the cycle, so the row reads as
// one heart sampled across a beat rather than four copies of the same frame.
const frameFor = (i: number) => Math.round((i * cine.frames) / Math.max(themes.length, 1));
---

<BaseLayout bleed>
  {/* ── Hero ──────────────────────────────────────────────────────────── */}
  <section class="hero">
    <div class="wrap grid">
      {/* Identity rail: a face and the profiles, above the fold, because that
          is the first thing anyone hiring actually looks for. It deliberately
          does not repeat the name — the h1 is right beside it. */}
      <aside class="rail" data-reveal="1">
        <Avatar />
        <ProfileLinks />
      </aside>

      <div class="intro">
        <p class="eyebrow" data-reveal="0">
          {[site.role, site.affiliation].filter(Boolean).join(' · ')}
        </p>

        <h1 data-reveal="1">{site.name}</h1>
        <p class="tagline" data-reveal="2">{site.tagline}</p>
        <p class="statement" data-reveal="3">{site.statement}</p>

        <ul class="chips" data-reveal="4">
          {chips.map((c) => <li><a class="chip" href={c.href}>{c.label}</a></li>)}
        </ul>

        <div class="cluster" data-reveal="5">
          <a class="btn btn-primary" href="/publications">Publications</a>
          {/* Scrolls to the contact card rather than firing a mail client at
              someone who has not decided to write yet. */}
          <a class="btn" href="#contact">Get in touch</a>
        </div>
      </div>

      <div class="media" data-reveal="2">
        <HeroCine />
      </div>
    </div>
  </section>

  <MetricBand />

  {/* ── Research: the signature row. Four loops on one clock. ─────────── */}
  <section class="section wrap" aria-labelledby="h-research">
    <div class="section-head">
      <p class="eyebrow">{copy.home.research.eyebrow}</p>
      <h2 id="h-research">{copy.home.research.title}</h2>
      <p class="lede">{copy.home.research.lede}</p>
    </div>

    {
      themes.length === 0 ? (
        <p class="empty">{copy.home.research.empty}</p>
      ) : (
        <>
          <ul class="theme-grid">
            {themes.map((theme, i) => (
              /* id is the hero chips' anchor target — see `chips` above. */
              <li id={theme.data.id} class="card theme" data-reveal={Math.min(i, 3)}>
                <div class="card-media">
                  <CineLoop
                    alt={`${theme.data.title} — cardiac cine loop`}
                    frame={frameFor(i)}
                  />
                  <span class="num badge">{String(i + 1).padStart(2, '0')}</span>
                </div>
                <div class="card-body">
                  <h3>
                    <a class="card-link" href={`/research#${theme.data.id}`}>
                      {theme.data.title}
                    </a>
                  </h3>
                  <p class="theme-summary">{theme.data.summary}</p>
                </div>
              </li>
            ))}
          </ul>
          <a class="more" href="/research">{copy.home.research.more} →</a>
        </>
      )
    }
  </section>

  {/* ── Selected work ─────────────────────────────────────────────────── */}
  <section class="band" aria-labelledby="h-selected">
    <div class="section wrap">
      <div class="section-head">
        <p class="eyebrow">{copy.home.selected.eyebrow}</p>
        <h2 id="h-selected">{copy.home.selected.title}</h2>
        <p class="lede">{copy.home.selected.lede}</p>
      </div>

      {
        featured.length === 0 ? (
          <p class="empty">{copy.home.selected.empty}</p>
        ) : (
          <>
            <ul class="pub-grid">
              {featured.map((pub, i) => (
                <li data-reveal={Math.min(i, 3)}>
                  <PublicationCard pub={pub} variant="card" />
                </li>
              ))}
            </ul>
            <a class="more" href="/publications">{copy.home.selected.more} →</a>
          </>
        )
      }
    </div>
  </section>

  {/* ── News + contact, side by side. Neither fills a row alone. ──────── */}
  <section class="section wrap split">
    <div aria-labelledby="h-news">
      <div class="section-head">
        <p class="eyebrow" id="h-news">{copy.home.news.eyebrow}</p>
      </div>
      {news.length === 0 ? <p class="empty">{copy.home.news.empty}</p> : <NewsList items={news} />}
    </div>

    <aside class="contact card" id="contact" aria-labelledby="h-contact">
      <CatMark class="contact-cat" />
      <div class="contact-body">
        <p class="eyebrow">{copy.home.contact.eyebrow}</p>
        <h2 id="h-contact">{copy.home.contact.title}</h2>
        <p class="contact-lede">{copy.home.contact.lede}</p>
        {/* Writing a message needs no mail client, so it leads; the address
            stays beside it for anyone who would rather copy it. */}
        <div class="cluster">
          <ContactForm />
          <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        {
          externals.length > 0 && (
            <ul class="chips">
              {externals.map((l) => (
                <li>
                  <a class="chip" href={l.href} rel="me noopener">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </aside>
  </section>
</BaseLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────── */

  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 6vh, 5rem) var(--section-y);
    overflow: hidden;
  }


  /* Rail, intro, cine. The rail is fixed-width so the two content columns
     absorb the page's flex rather than the photo growing with it.

     ── The cine's size lives here ──────────────────────────────────────────
     The third value is the cine column. Lower it to shrink the loop, raise it
     to grow it — 0.86fr is roughly 15% smaller than the intro column beside
     it. Nothing else needs touching; the canvas and the contour overlay both
     scale off this width. */
  .grid {
    display: grid;
    /* First value is the rail: wide enough that the longest label holds one
       line, because a city/state/country wrapping mid-address reads as an
       accident rather than a choice. */
    grid-template-columns: 12.75rem minmax(0, 1fr) minmax(0, 0.75fr);
    gap: clamp(1.5rem, 3vw, 2.75rem) clamp(1.75rem, 3vw, 3rem);
    align-items: center;
  }

  /* Rail and intro share a top edge so the photo lines up with the eyebrow.
     The cine stays centred — it is taller than both and centring keeps the
     row balanced. */
  .rail,
  .intro {
    align-self: start;
  }

  .rail {
    display: grid;
    gap: var(--sp-5);
  }

  .intro > * + * {
    margin-block-start: var(--sp-5);
  }

  h1 {
    font-size: var(--text-4xl);
    margin-block-start: var(--sp-4);
  }

  .tagline {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--ink-secondary);
    letter-spacing: var(--tracking-tight);
    margin-block-start: var(--sp-2);
  }

  .statement {
    max-width: 52ch;
    color: var(--ink-secondary);
  }

  /* ── Research grid ──────────────────────────────────────────────────── */

  .theme-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--sp-5);
  }

  .theme {
    scroll-margin-top: 6rem;
  }

  /* Square cine cropped to a letterbox, so four cards in a row stay compact
     without stretching the frame. */
  .theme .card-media {
    aspect-ratio: 5 / 4;
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .theme .card-media > :global(.cine) {
    width: 100%;
  }

  .badge {
    position: absolute;
    z-index: 3;
    top: var(--sp-3);
    left: var(--sp-3);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(4px);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-wide);
    color: #fff;
  }

  .theme h3 {
    font-size: var(--text-lg);
  }

  .theme h3 a {
    text-decoration: none;
  }

  .theme:hover h3 a {
    color: var(--accent);
  }

  .theme-summary {
    font-size: var(--text-base);
    color: var(--ink-secondary);
  }

  /* ── Selected work ──────────────────────────────────────────────────── */

  .pub-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--sp-5);
  }

  /* Caps the tile when there are fewer papers than columns — auto-fit would
     otherwise stretch two cards across the whole row. */
  .pub-grid > li {
    display: flex;
    max-width: 30rem;
  }

  .pub-grid > li > :global(*) {
    flex: 1;
  }

  /* ── News + contact ─────────────────────────────────────────────────── */

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .contact {
    position: relative;
    overflow: hidden;
    /* The hero button jumps here; clear the sticky header. */
    scroll-margin-top: 6rem;
  }

  .contact:hover {
    transform: none;
  }

  /* Sits fully inside the corner rather than bleeding off it — this one is a
     small piece of character, and cropping a cat in half reads as a mistake.
     `:global` because it is a child component's root element. */
  .contact :global(.contact-cat) {
    position: absolute;
    z-index: 0;
    top: var(--sp-4);
    right: var(--sp-4);
    width: 3.75rem;
    pointer-events: none;
  }

  .contact-body {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--sp-4);
    justify-items: start;
    padding: var(--sp-6);
  }

  .contact-lede {
    color: var(--ink-secondary);
    font-size: var(--text-base);
  }

  /* Between the two breakpoints the rail would squeeze the headline, so it
     moves above the text and lies down: photo beside links, not under them. */
  @media (width < 72rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
    }
    .rail {
      grid-column: 1 / -1;
      grid-auto-flow: column;
      grid-template-columns: 7.5rem minmax(0, 1fr);
      align-items: center;
      gap: var(--sp-5);
      justify-content: start;
    }
  }

  @media (width < 60rem) {
    .grid {
      grid-template-columns: 1fr;
    }
    .media {
      max-width: 34rem;
    }
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
