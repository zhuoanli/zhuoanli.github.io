---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCine from '../components/HeroCine.astro';
import MetricBand from '../components/MetricBand.astro';
import { site } from '../data/site';
---

<BaseLayout bleed>
  <section class="hero">
    <div class="wrap grid">
      <div class="intro">
        <p class="eyebrow" data-reveal="0">
          {[site.role, site.affiliation].filter(Boolean).join(' · ')}
        </p>

        <h1 data-reveal="1">{site.name}</h1>
        <p class="tagline" data-reveal="2">{site.tagline}</p>
        <p class="statement" data-reveal="3">{site.statement}</p>

        <ul class="chips" data-reveal="4">
          {
            site.capabilities.map((c) => (
              <li>
                <a href={`#${c.id}`}>{c.label}</a>
              </li>
            ))
          }
        </ul>

        <div class="cta" data-reveal="5">
          <a class="btn btn-primary" href="/publications">Publications</a>
          <a class="btn" href={`mailto:${site.email}`}>Get in touch</a>
        </div>
      </div>

      <div class="media" data-reveal="2">
        <HeroCine />
      </div>
    </div>
  </section>

  <MetricBand />

  <section class="section wrap" id="foundation-models">
    <p class="eyebrow">Placeholder</p>
    <p class="prose" style="margin-top:1rem">
      Sections for selected work, research themes and news land here next. The
      frame, the type scale and both themes are what to judge at this stage.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vh, 5rem) var(--section-y);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .intro > * + * {
    margin-block-start: var(--sp-5);
  }

  h1 {
    font-size: var(--text-4xl);
    margin-block-start: var(--sp-4);
  }

  .tagline {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--ink-secondary);
    letter-spacing: var(--tracking-tight);
    margin-block-start: var(--sp-2);
  }

  .statement {
    max-width: 52ch;
    color: var(--ink-secondary);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
    padding: 0;
  }

  .chips a {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--ink-muted);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
  }

  .chips a:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 480;
    text-decoration: none;
    color: var(--ink);
    transition: background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .btn:hover {
    background: var(--surface-hover);
    border-color: var(--ink-faint);
    color: var(--ink);
  }

  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: var(--accent-ink);
  }

  @media (width < 60rem) {
    .grid {
      grid-template-columns: 1fr;
    }
    .media {
      max-width: 32rem;
    }
  }
</style>
