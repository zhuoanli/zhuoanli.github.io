---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/collections';
import { copy } from '../data/copy';

const projects = await getProjects();
---

<BaseLayout title="Projects" description={copy.projects.lede}>
  <PageHeader
    eyebrow={copy.projects.eyebrow}
    title={copy.projects.title}
    lede={copy.projects.lede}
  />

  <div class="wrap page-body">
    {
      projects.length === 0 ? (
        <p class="empty">{copy.projects.empty}</p>
      ) : (
        <ul class="grid">
          {projects.map((project, i) => (
            <li data-reveal={Math.min(i, 4)}>
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .page-body {
    padding-block: var(--sp-7) var(--section-y);
  }

  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--sp-5);
  }

  .grid > li {
    display: flex;
  }

  .grid > li > :global(*) {
    flex: 1;
  }
</style>
