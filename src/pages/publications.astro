---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { allThemes, getPublications, groupByYear, isRedacted } from '../lib/collections';
import { hasEqualContribution } from '../lib/authors';
import { copy } from '../data/copy';

const pubs = await getPublications();
const groups = groupByYear(pubs);

// Redacted entries contribute no topics. Their themes would otherwise reach the
// page twice — as a filter chip and as a `data-themes` attribute — which is a
// topic leak about an anonymous submission that "title, venue, status only"
// is meant to prevent.
const themes = allThemes(pubs.filter((p) => !isRedacted(p)));

// The footnote only appears if some visible paper actually uses the marker.
const showEqualNote = pubs.some((p) => !isRedacted(p) && hasEqualContribution(p.data.authors));
---

<BaseLayout title="Publications" description={copy.publications.lede}>
  <PageHeader
    eyebrow={copy.publications.eyebrow}
    title={copy.publications.title}
    lede={copy.publications.lede}
  />

  <div class="wrap page-body" data-pubs>
    {
      themes.length > 1 && (
        <div class="filter no-print" data-reveal="0">
          <p class="filter-label" id="filter-label">
            {copy.publications.filterLabel}
          </p>
          {/* Buttons, not links: with JS off nothing is filtered and every
              paper stays visible, which is the correct fallback. */}
          <ul class="chips" role="group" aria-labelledby="filter-label">
            <li>
              <button type="button" class="chip" data-filter="*" aria-pressed="true">
                {copy.publications.filterAll}
              </button>
            </li>
            {themes.map((theme) => (
              <li>
                <button
                  type="button"
                  class="chip"
                  data-filter={theme}
                  aria-pressed="false"
                  data-gc={`filter:${theme}`}
                  data-gc-title={`Topic filter — ${theme}`}
                >
                  {theme}
                </button>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      groups.length === 0 ? (
        <p class="empty">{copy.publications.empty}</p>
      ) : (
        <>
          {groups.map((group) => (
            <section class="year-group" data-year-group>
              <h2 class="eyebrow year">{group.year}</h2>
              <ol class="pub-list">
                {group.items.map((pub, i) => (
                  <li
                    data-themes={isRedacted(pub) ? '' : pub.data.themes.join('|')}
                    data-reveal={Math.min(i, 4)}
                  >
                    <PublicationCard pub={pub} />
                  </li>
                ))}
              </ol>
            </section>
          ))}

          <p class="empty" data-no-match hidden>
            {copy.publications.noMatch}
          </p>

          {showEqualNote && <p class="footnote">{copy.publications.equalNote}</p>}
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .page-body {
    padding-block: var(--sp-7) var(--section-y);
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-4);
    padding-block-end: var(--sp-5);
  }

  .filter-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .year-group + .year-group {
    margin-block-start: var(--sp-8);
  }

  .year {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    color: var(--ink-muted);
    margin-block-end: var(--sp-5);
  }

  .pub-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pub-list > li {
    padding-block: var(--sp-6);
    border-block-start: 1px solid var(--line);
  }

  .pub-list > li:first-child {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .footnote {
    margin-block-start: var(--sp-7);
    padding-block-start: var(--sp-4);
    border-block-start: 1px solid var(--line);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }
</style>

<script>
  // Attribute-level filtering. No framework, no re-render: the full list is in
  // the HTML and JS only sets `hidden`.
  const root = document.querySelector<HTMLElement>('[data-pubs]');
  const buttons = root?.querySelectorAll<HTMLButtonElement>('[data-filter]') ?? [];
  const items = root?.querySelectorAll<HTMLElement>('[data-themes]') ?? [];
  const groups = root?.querySelectorAll<HTMLElement>('[data-year-group]') ?? [];
  const noMatch = root?.querySelector<HTMLElement>('[data-no-match]');

  function apply(theme: string) {
    for (const item of items) {
      const themes = (item.dataset.themes || '').split('|').filter(Boolean);
      item.hidden = theme !== '*' && !themes.includes(theme);
    }

    // A year heading with nothing under it is worse than no heading.
    let anyVisible = false;
    for (const group of groups) {
      const visible = group.querySelectorAll('[data-themes]:not([hidden])').length > 0;
      group.hidden = !visible;
      anyVisible ||= visible;
    }

    if (noMatch) noMatch.hidden = anyVisible;
    for (const btn of buttons) {
      btn.setAttribute('aria-pressed', String(btn.dataset.filter === theme));
    }
  }

  for (const btn of buttons) {
    btn.addEventListener('click', () => apply(btn.dataset.filter ?? '*'));
  }
</script>
