---
import { copy } from '../data/copy';

interface Props {
  bibtex: string;
}

const { bibtex } = Astro.props;
---

<div class="bib" data-bibtex>
  <div class="bar">
    <span class="label">BibTeX</span>
    <button
      type="button"
      class="btn btn-sm"
      data-copy
      data-idle={copy.publication.copyBibtex}
      data-done={copy.publication.copiedBibtex}
    >
      {copy.publication.copyBibtex}
    </button>
  </div>
  <pre><code>{bibtex}</code></pre>
</div>

<style>
  .bib {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-sunken);
    overflow: hidden;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-2) var(--sp-2) var(--sp-4);
    border-block-end: 1px solid var(--line);
  }

  .label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  pre {
    margin: 0;
    padding: var(--sp-4);
    overflow-x: auto;
    font-size: var(--text-xs);
    line-height: 1.65;
    color: var(--ink-secondary);
    tab-size: 2;
  }
</style>

<script>
  // Without a clipboard API the button would silently do nothing, so remove it
  // and leave the <pre> — selectable text is a working fallback.
  for (const block of document.querySelectorAll<HTMLElement>('[data-bibtex]')) {
    const btn = block.querySelector<HTMLButtonElement>('[data-copy]');
    if (!btn) continue;

    if (!navigator.clipboard) {
      btn.remove();
      continue;
    }

    let timer: ReturnType<typeof setTimeout>;
    btn.addEventListener('click', async () => {
      const text = block.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = btn.dataset.done ?? 'Copied';
        clearTimeout(timer);
        timer = setTimeout(() => {
          btn.textContent = btn.dataset.idle ?? 'Copy BibTeX';
        }, 1600);
      } catch {
        /* Clipboard blocked by permissions; the text is still selectable. */
      }
    });
  }
</script>
