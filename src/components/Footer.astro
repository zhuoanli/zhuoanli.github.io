---
import { site } from '../data/site';

const year = new Date().getFullYear();

// Only render links that have actually been filled in.
const external = [
  { label: 'GitHub', href: site.links.github },
  { label: 'Google Scholar', href: site.links.scholar },
  { label: 'ORCID', href: site.links.orcid },
  { label: 'LinkedIn', href: site.links.linkedin },
].filter((l) => l.href);
---

<footer class="footer">
  <div class="wrap inner">
    <div class="col">
      <p class="name">{site.name}</p>
      <p class="meta">
        {[site.role, site.affiliation, site.location].filter(Boolean).join(' · ')}
      </p>
      <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>

    {
      external.length > 0 && (
        <nav class="col" aria-label="Elsewhere">
          <p class="eyebrow-plain">Elsewhere</p>
          <ul>
            {external.map((l) => (
              <li>
                <a href={l.href} rel="me noopener">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <nav class="col" aria-label="Secondary">
      <p class="eyebrow-plain">Site</p>
      <ul>
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="wrap bottom">
    <p>© {year} {site.name}</p>
    <p class="colophon">
      Set in Newsreader &amp; Inter. Built with Astro. The cine loop is real
      MedSAM2 output.
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-block-start: var(--sp-9);
    border-top: 1px solid var(--line);
    background: var(--bg-sunken);
    padding-block: var(--sp-8) var(--sp-6);
  }

  .inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--sp-6);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .meta {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    margin-block-start: var(--sp-1);
  }

  .mail {
    display: inline-block;
    margin-block-start: var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }

  .eyebrow-plain {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-block-end: var(--sp-3);
  }

  .col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-2);
  }

  .col a {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    text-decoration: none;
  }

  .col a:hover {
    color: var(--accent);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-5);
    justify-content: space-between;
    margin-block-start: var(--sp-7);
    padding-block-start: var(--sp-5);
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .colophon {
    font-family: var(--font-mono);
  }

  @media (width < 46rem) {
    .inner {
      grid-template-columns: 1fr 1fr;
    }
    .col:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
