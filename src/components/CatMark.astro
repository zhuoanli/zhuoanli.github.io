---
/**
 * The cat from the favicon, reused as a page emblem.
 *
 * The source artwork is two fixed colours — a near-black body against a cream
 * laptop — which vanishes on a dark card. Inlined here instead of dropped in
 * as an <img> so the two tones can be driven by custom properties and swap
 * with the theme: the silhouette stays readable on either ground.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['cat', className]}
  viewBox="0 0 32 32"
  role="img"
  aria-label="A cat peering over a laptop"
>
  <path
    d="M2.2 22.7h4.2m21.1 0h2.3"
    fill="none"
    stroke="var(--cat-ink)"
    stroke-width="1.55"
    stroke-linecap="round"></path>

  <path
    d="M5.5 22.7c-.5-1.48-.2-2.88.93-4.02-1.04-.94-1.56-2.34-1.42-4.03.18-2.24 1.32-4.01 3.18-5.08l.84-3.27c.12-.49.71-.67 1.07-.33l2.35 2.23a11.7 11.7 0 0 1 6.44 0l2.35-2.23c.36-.34.95-.16 1.07.33l.84 3.27c1.86 1.07 3 2.84 3.18 5.08.14 1.69-.38 3.09-1.42 4.03 1.13 1.14 1.18 2.54.68 4.02H5.5Z"
    fill="var(--cat-ink)"></path>

  <circle cx="11.45" cy="15.25" r="1.25" fill="var(--cat-paper)"></circle>
  <circle cx="19.85" cy="15.25" r="1.25" fill="var(--cat-paper)"></circle>

  <path
    d="M14.55 22.15c-1.58-.02-2.76.06-3.8.19-.4.05-.51.57-.18.8l2.9 1.95c.51.35 1.18.09 1.34-.5l.5-1.82"
    fill="var(--cat-paper)"
    stroke="var(--cat-ink)"
    stroke-width="1.4"
    stroke-linejoin="round"></path>

  <path
    d="M14.05 17.75h13.5l-.72 9.25H14.77l-.72-9.25Z"
    fill="var(--cat-paper)"
    stroke="var(--cat-ink)"
    stroke-width="1.55"
    stroke-linejoin="round"></path>

  <path
    d="M14.75 27h12.1"
    fill="none"
    stroke="var(--cat-ink)"
    stroke-width="1.55"
    stroke-linecap="round"></path>
</svg>

<style>
  .cat {
    display: block;
    width: 100%;
    height: auto;
    /* On paper the cat is black and the laptop is cream, as drawn. */
    --cat-ink: #111214;
    --cat-paper: #f7f5ef;
  }

  /* On a dark ground the two tones trade places, so the silhouette still
     reads instead of sinking into the card. */
  :global(:root[data-theme='dark']) .cat {
    --cat-ink: #e9eaec;
    --cat-paper: #14171b;
  }
</style>
