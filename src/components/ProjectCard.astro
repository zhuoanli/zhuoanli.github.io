---
import { Image } from 'astro:assets';
import LinkRow from './LinkRow.astro';
import ContourMark from './ContourMark.astro';
import type { Project } from '../lib/collections';
import { cine } from '../lib/contours';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;

// The card title links out to whatever the project actually is, in preference
// order. There are no project detail pages, so a card with no links is inert
// by design rather than by accident.
const primary = data.links.project || data.links.code || data.links.pdf;

const markFrame =
  [...project.id].reduce((acc, ch) => (acc * 31 + ch.charCodeAt(0)) % cine.frames, 3);
---

<article class="card project">
  <div class="card-media">
    {
      data.cover ? (
        <Image
          src={data.cover}
          alt={data.coverAlt ?? ''}
          widths={[480, 960]}
          sizes="(width < 56rem) 100vw, 24rem"
          loading="lazy"
        />
      ) : (
        <div class="mark-panel">
          <ContourMark frame={markFrame} variant="anatomy" weight={7} />
        </div>
      )
    }
  </div>

  <div class="card-body">
    <p class="meta">
      <span class="num">{data.period}</span>
      {data.role && <><span class="dot" aria-hidden="true">·</span>{data.role}</>}
    </p>

    <h3 class="title">
      {primary ? <a class="card-link" href={primary}>{data.title}</a> : data.title}
    </h3>

    <p class="summary">{data.summary}</p>

    {
      data.metrics.length > 0 && (
        <dl class="metrics">
          {data.metrics.map((m) => (
            <div class="metric">
              <dt>{m.label}</dt>
              <dd class="num">{m.value}</dd>
              {m.note && <p class="note">{m.note}</p>}
            </div>
          ))}
        </dl>
      )
    }

    {
      data.stack.length > 0 && (
        <ul class="chips">
          {data.stack.map((s) => (
            <li>
              <span class="chip">{s}</span>
            </li>
          ))}
        </ul>
      )
    }

    <LinkRow links={data.links} exclude={['bibtex', 'project']} context={project.id} />
  </div>
</article>

<style>
  .project {
    height: 100%;
  }

  .card-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .project:hover .card-media :global(img) {
    transform: scale(1.04);
  }

  .mark-panel {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--sp-4);
    background:
      radial-gradient(70% 70% at 50% 45%, rgb(61 219 217 / 0.09), transparent 72%),
      var(--viewport-bg);
  }

  .mark-panel :global(.mark) {
    width: auto;
    height: 78%;
    max-width: 40%;
    opacity: 0.85;
    filter: drop-shadow(0 0 6px rgb(0 0 0 / 0.6));
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .project:hover .mark-panel :global(.mark) {
    transform: scale(1.05);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--ink-muted);
  }

  .dot {
    margin-inline: 0.4em;
    color: var(--ink-faint);
  }

  .title {
    font-size: var(--text-lg);
  }

  .title a {
    text-decoration: none;
  }

  .project:hover .title a {
    color: var(--accent);
  }

  .summary {
    color: var(--ink-secondary);
    font-size: var(--text-base);
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    padding-block: var(--sp-3);
    border-block: 1px solid var(--line);
    margin: 0;
  }

  .metric dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .metric dd {
    margin: 0;
    font-size: var(--text-md);
    color: var(--ink);
  }

  .note {
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  /* Push the link row to the bottom so cards in a row align on it. */
  .card-body > :global(.links) {
    margin-block-start: auto;
    padding-block-start: var(--sp-2);
    /* Sits above the card-wide link overlay so these stay clickable. */
    position: relative;
    z-index: 4;
  }
</style>
